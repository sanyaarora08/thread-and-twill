# Copy this file to ".env" for running on your own computer.
# On your host (Render, Railway and so on), add these as environment variables instead.
# Never put real keys in a file you upload to GitHub.

# From Razorpay Dashboard > Account & Settings > API Keys.
# Use the Test keys first (they start with rzp_test_). Switch to Live keys only when you launch.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# From Razorpay Dashboard > Account & Settings > Webhooks (you choose this secret yourself).
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# Set to 1 when your host puts a proxy in front of the site (Render, Railway and most hosts do).
TRUST_PROXY=1

# Password for the admin page at /admin (orders, sales, customer details).
# Use 12 or more characters. The admin page stays switched off without it.
ADMIN_PASSWORD=choose-a-long-private-password

# Optional. Without this, admin sign-ins end whenever the site restarts.
# ADMIN_SESSION_SECRET=another-long-random-string

# Optional. Where the order log is saved. Point this at a persistent disk if your host has one.
# DATA_DIR=/var/data
